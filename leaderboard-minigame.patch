diff --git a/src/lib/game-score-service.ts b/src/lib/game-score-service.ts
new file mode 100644
index 0000000..a853b91
--- /dev/null
+++ b/src/lib/game-score-service.ts
@@ -0,0 +1,26 @@
+export interface LeaderboardEntry {
+  name: string;
+  score: number;
+}
+
+export async function fetchLeaderboard(): Promise<LeaderboardEntry[]> {
+  const res = await fetch("/api/game-scores", { cache: "no-store" });
+  if (!res.ok) throw new Error("Gagal memuat leaderboard.");
+  const json = (await res.json()) as { scores: LeaderboardEntry[] };
+  return json.scores;
+}
+
+export async function submitScore(name: string, score: number) {
+  const res = await fetch("/api/game-scores", {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ name, score }),
+  });
+  const json = (await res.json().catch(() => ({}))) as {
+    error?: string;
+    isNewBest?: boolean;
+    scores?: LeaderboardEntry[];
+  };
+  if (!res.ok) throw new Error(json.error ?? "Gagal menyimpan skor.");
+  return { isNewBest: Boolean(json.isNewBest), scores: json.scores ?? [] };
+}
diff --git a/supabase/migrations/012_game_scores.sql b/supabase/migrations/012_game_scores.sql
new file mode 100644
index 0000000..569225a
--- /dev/null
+++ b/supabase/migrations/012_game_scores.sql
@@ -0,0 +1,21 @@
+-- ============================================================
+-- Leaderboard mini game "Catch the Love".
+-- Satu baris per pemain (nama dinormalisasi huruf kecil) berisi skor terbaik.
+-- RLS aktif TANPA policy: anon key tidak bisa baca/tulis langsung.
+-- Semua akses lewat /api/game-scores (service-role) yang memvalidasi skor.
+-- Jalankan di Supabase Dashboard → SQL Editor, SEBELUM deploy.
+-- ============================================================
+
+create table if not exists game_scores (
+  name_key    text primary key,
+  name        text not null check (char_length(name) between 1 and 40),
+  score       integer not null check (score between 0 and 2000),
+  plays       integer not null default 1,
+  created_at  timestamptz not null default now(),
+  updated_at  timestamptz not null default now()
+);
+
+create index if not exists game_scores_rank_idx
+  on game_scores (score desc, updated_at asc);
+
+alter table game_scores enable row level security;