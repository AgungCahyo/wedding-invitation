+/* ── Editorial Romantic design: big serif display + tracked-out sans label/body. ── */
+html[data-design="editorial"] {
+  --font-display: var(--font-fraunces), Georgia, serif;
+  --font-body: var(--font-dm-sans), system-ui, sans-serif;
+  --font-label: var(--font-outfit), system-ui, sans-serif;
+}
+
+html[data-design="editorial"] body {
+  background-image: none;
+  background-color: var(--bg-primary);
+  font-family: var(--font-dm-sans), system-ui, sans-serif;
+}
+
+html[data-design="editorial"] h1,
+html[data-design="editorial"] h2,
+html[data-design="editorial"] h3,
+html[data-design="editorial"] h4 {
+  font-family: var(--font-fraunces), Georgia, serif;
+  font-weight: 500;
+  letter-spacing: -0.02em;
+}
+
