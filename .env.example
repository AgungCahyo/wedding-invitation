# Copy to .env.local and fill in values. Do not commit secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin (server). NEXT_PUBLIC_ADMIN_PIN is a legacy fallback — prefer ADMIN_PIN.
ADMIN_PIN=
NEXT_PUBLIC_ADMIN_PIN=

# Public site URL (guest links, WhatsApp). Falls back to invitation.meta.url.
NEXT_PUBLIC_SITE_URL=

# WhatsApp: meta (default) | fonnte | waha
WHATSAPP_PROVIDER=

# Meta Cloud API (WHATSAPP_PROVIDER=meta or unset)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_MODE=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=
WHATSAPP_API_VERSION=
WHATSAPP_GRAPH_URL=

# Fonnte (WHATSAPP_PROVIDER=fonnte)
FONNTE_TOKEN=
FONNTE_API_URL=

# WAHA (WHATSAPP_PROVIDER=waha)
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=
