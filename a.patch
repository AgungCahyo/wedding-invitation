new file mode 100644
index 0000000..49de62d
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,41 @@
+# Salin ke .env.local lalu isi. Jangan commit nilai asli.
+
+# ── Supabase ─────────────────────────────────────────────
+NEXT_PUBLIC_SUPABASE_URL=
+NEXT_PUBLIC_SUPABASE_ANON_KEY=
+# Hanya server. Jangan pernah diberi awalan NEXT_PUBLIC_.
+SUPABASE_SERVICE_ROLE_KEY=
+
+# ── Admin ────────────────────────────────────────────────
+# PIN login panel /admin, diperiksa di server.
+# Kode masih menerima NEXT_PUBLIC_ADMIN_PIN sebagai fallback lama;
+# gunakan ADMIN_PIN untuk instalasi baru.
+ADMIN_PIN=
+
+# ── Situs ────────────────────────────────────────────────
+# Dipakai untuk membangun link undangan di pesan WhatsApp.
+# Jika kosong, dipakai invitation.meta.url (src/data/invitation.ts).
+NEXT_PUBLIC_SITE_URL=
+
+# ── WhatsApp (opsional, pilih satu provider) ─────────────
+# meta | fonnte | waha   (default: meta)
+WHATSAPP_PROVIDER=meta
+
+# Provider meta (WhatsApp Cloud API)
+WHATSAPP_ACCESS_TOKEN=
+WHATSAPP_PHONE_NUMBER_ID=
+# template | text   (default: template)
+WHATSAPP_MODE=template
+WHATSAPP_TEMPLATE_NAME=
+WHATSAPP_TEMPLATE_LANG=id
+WHATSAPP_API_VERSION=v21.0
+WHATSAPP_GRAPH_URL=https://graph.facebook.com
+
+# Provider fonnte
+FONNTE_TOKEN=
+FONNTE_API_URL=https://api.fonnte.com/send
+
+# Provider waha
+WAHA_URL=
+WAHA_API_KEY=
+WAHA_SESSION=default
